# OpenRouter — chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Provedor de IA: openrouter (nuvem) | ollama (local / air-gapped)
# AI_PROVIDER=openrouter
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_FALLBACK_MODEL=llama3.1:8b
# OLLAMA_API_KEY=ollama

# Modelos (preferir OPENROUTER_* — GEMINI_* mantido por compatibilidade)
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v3.2
# GEMINI_MODEL=google/gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=deepseek/deepseek-v3.2

# Servidor — 127.0.0.1 = só localhost (recomendado)
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
# Token opcional para proteger /api/* (header X-Chat-Token)
# CHAT_API_TOKEN=
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Só ative atrás de reverse proxy que limpa X-Forwarded-For do cliente
# TRUST_PROXY=true
# LOG_LEVEL=INFO

# Container Docker Kali
KALI_CONTAINER=kali-tools
COMMAND_TIMEOUT=180
WIFI_COMMAND_TIMEOUT=600
MAX_TOOL_ITERATIONS=10
MAX_TOOL_ITERATIONS_OFFENSIVE=14
MAX_HEALING_ATTEMPTS=2
MAX_AUTONOMOUS_ROUNDS=10
MAX_AUTONOMOUS_TOOLS=25
OUTPUT_TOKEN_LIMIT=3000
SUMMARY_HEAD_LINES=30
SUMMARY_TAIL_LINES=15
MAX_HISTORY_MESSAGES=10
RECON_TTL_DAYS=30
# Pasta de artefatos (host) montada em /tools/output no container Kali
# OUTPUTS_DIR=backend/outputs
# Alvos permitidos (opcional). Vazio = sem restrição (UI exibe aviso). Ex:
# ALLOWED_TARGETS=scanme.nmap.org,10.0.0.5,lab.local
# Perfil Auto-Pilot: passive | safe-active | full
# RISK_PROFILE=safe-active
# Pipeline PoC: quantos findings verificar (high/critical sempre entram; máx 80)
# VERIFY_MAX_FINDINGS=40
# Marca nos relatórios HTML/PDF (legado — preferir CONSULTING_*)
# REPORT_BRAND_NAME=DarkStar
# White-label da consultoria (PDF capa/rodapé)
# CONSULTING_NAME=DarkStar
# CONSULTING_LOGO_PATH=assets/darkstar-logo.png
# CONSULTING_PRIMARY_COLOR=#1E90FF
# CONSULTING_FOOTER=Documento confidencial — uso autorizado apenas.
# Timeout do sumário executivo via LLM (segundos)
# EXECUTIVE_SUMMARY_TIMEOUT=15

# MSSP local — recorrência / alertas / retenção / papel (sem portal do cliente)
# SCHEDULE_ENABLED=true
# SCHEDULE_TICK_SEC=60
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_ON_CRITICAL=true
# ALERT_RISK_JUMP=15
# GitHub API (comentários em PR / issues / commit status) — local ou CI
# GITHUB_TOKEN=
# Notificações multicanal (opcional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_CHANNEL=#security
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=security@example.com
# EMAIL_TO=team@example.com
# JIRA_URL=https://your.atlassian.net
# JIRA_USER=user@example.com
# JIRA_TOKEN=
# JIRA_PROJECT=SEC
# AUTO_BASELINE_AFTER_VERIFY=true
# RETENTION_DAYS=90
# OPERATOR_ROLE=admin

# Auditoria e downloads
# AUDIT_DIR=backend/audit
# MAX_FILE_DOWNLOAD_MB=50
SESSION_TTL_HOURS=24
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SEC=60

# Threat Intelligence — enriquece CVEs do Attack Surface com CISA KEV + FIRST EPSS
# THREAT_INTEL_ENABLED=true
# THREAT_INTEL_CACHE_TTL=21600

# Servidor MCP (Model Context Protocol) — expõe tools/resources em /api/mcp/*
# e via stdio (python -m backend.mcp_server) para Cursor/Claude Desktop
# MCP_ENABLED=true

# Intelligence Hub — histórico local (json) ou PostgreSQL
# INTELLIGENCE_ENABLED=true
# INTELLIGENCE_TTL_DAYS=90
# INTELLIGENCE_STORAGE=json
# INTELLIGENCE_DIR=backend/intelligence_data
# PostgreSQL (quando INTELLIGENCE_STORAGE=postgres):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/ChatIA

# Master key DarkStar — desbloqueia perfil full (sem ela = perfil B restrito)
# Gere: python -c "import secrets; print(secrets.token_urlsafe(64))"
# MASTER_KEY=

# Compliance mapper indicativo (não é certificação)
# COMPLIANCE_ENABLED=true
